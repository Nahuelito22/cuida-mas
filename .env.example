# Copiar a .env para personalizar. Todas tienen un valor por defecto en docker-compose.yml,
# así que el proyecto también levanta sin este archivo.

# Secreto para firmar los JWT (en producción, uno largo y aleatorio).
JWT_SECRET=cambiar-este-secreto-en-produccion
# Duración del token en segundos (28800 = 8 horas).
JWT_EXPIRES_IN_SECONDS=28800

# Puertos de la PC donde se publican los servicios (elegidos para no chocar con otros proyectos).
FRONTEND_HOST_PORT=5180
GATEWAY_HOST_PORT=3100
MONGO_HOST_PORT=27030
